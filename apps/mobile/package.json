{
  "name": "@railone/mobile",
  "version": "4.0.0",
  "description": "RailOne Next — Mobile Native Railway Passenger Application for Android and iOS",
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=10.0.0"
  },
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "tsc --noEmit",
    "test": "node --test",
    "doctor": "npx --yes expo-doctor",
    "build:web": "expo export -p web --no-minify",
    "prebuild": "expo prebuild --clean --no-install"
  },
  "dependencies": {
    "expo": "^53.0.27",
    "expo-av": "~15.1.7",
    "expo-constants": "~17.1.8",
    "expo-font": "~13.3.2",
    "expo-haptics": "~14.1.0",
    "expo-linking": "~7.1.0",
    "expo-router": "~5.1.11",
    "expo-speech": "~13.1.7",
    "expo-status-bar": "~2.2.3",
    "query-string": "^9.5.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-native": "^0.79.6",
    "react-native-safe-area-context": "^5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-svg": "^15.11.2",
    "react-native-web": "^0.20.0",
    "write-file-atomic": "^8.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/react": "~19.0.10",
    "typescript": "~5.8.3"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "expo-av"
        ]
      }
    }
  },
  "private": true
}
