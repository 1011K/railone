# ============================================================================
# RAILONE NEXT - ENVIRONMENT CONFIGURATION (FREE API TIERS)
# All keys are optional. RailOne falls back deterministically if unconfigured.
# ============================================================================

# 1. Google Gemini (Primary AI Provider)
# Obtain free API key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# 2. NVIDIA NIM (AI Reasoning Provider - Free Developer Tier)
# Obtain free developer credits from NVIDIA API Catalog: https://build.nvidia.com/
# OpenAI-compatible API base: https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=""
NVIDIA_MODEL="meta/llama-3.3-70b-instruct"

# 3. Groq (Fast Inference & Whisper Transcription - Free Tier)
# Obtain free API key from Groq Console: https://console.groq.com/keys
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# 4. OpenRouteService / HeiGIT (Pedestrian Navigation - Free Tier)
# Obtain free API key from HeiGIT ORS: https://account.heigit.org/
# API base endpoint: https://api.heigit.org/v2/directions
ORS_API_KEY=""

# 5. Open-Meteo Weather (Free Tier, No Key Required)
# Free public endpoint: https://api.open-meteo.com/v1/forecast

# 6. MapLibre + OpenFreeMap (Free Vector Tiles, No Key Required)
# Free public endpoint: https://tiles.openfreemap.org/styles/liberty

# 7. Application Server Config
PORT=3000
APP_URL="http://localhost:3000"
